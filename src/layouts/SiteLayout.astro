---
/**
 * Shared layout for the custom (non-Starlight) pages: the landing and the
 * roadmap. Owns the blueprint frame, the slim header and footer, head/meta
 * (OG + Cloudflare beacon, matching astro.config), and theme handling that
 * shares Starlight's `starlight-theme` localStorage key so the light/dark
 * choice persists across the custom pages and the docs.
 */
import '../styles/tokens.css'
import Logo from '../components/Logo.astro'
import CookieConsent from '../components/CookieConsent.astro'

interface Props {
  title: string
  description?: string
  /** Active top-nav item, for aria-current. */
  active?: 'home' | 'roadmap'
}
const {
  title,
  description = 'A live database structure viewer for Laravel. See your schema as a scrollable, zoomable ER diagram, right inside your app. Structure only, never row data.',
  active,
} = Astro.props

const site = Astro.site ?? new URL('https://trussphp.com')
const canonical = new URL(Astro.url.pathname, site).href
const cover = new URL('/cover-light.png', site).href

const nav = [
  { label: 'Docs', href: '/getting-started/installation/' },
  { label: 'Roadmap', href: '/roadmap/', key: 'roadmap' },
  { label: 'Demo', href: '/demo/' },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Preload the mono family so it is in place before first paint. Paired with
        font-display: optional in tokens.css, this is what keeps the text from
        re-measuring and shifting the layout (CLS). All three weights, 44KB total,
        because leaving 500 and 600 to load late just moves the shift to the
        headings. Starlight pages do not use this layout, so the same preloads
        are repeated in the head array in astro.config.mjs. */}
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-600.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cover} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cover} />

    {/* Apply the shared theme before paint to avoid a flash. Reads Starlight's
        key so a choice made in the docs carries over here, and vice versa. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('starlight-theme')
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
          document.documentElement.dataset.theme = theme
        } catch (e) {}
      })()
    </script>

    {/* Cloudflare Web Analytics beacon (cookieless, public token), matching the
        Starlight pages so RUM covers the whole site. */}
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "7f6eaa0832eb43cc838db8d337590f11"}'></script>
  </head>

  <body>
    {/* WCAG 2.4.1 Bypass Blocks. Starlight emits one of these on the docs
        pages; these hand-authored pages own their own shell, so nothing
        generated one and every visit began by tabbing the whole header.
        Hidden until it takes focus. */}
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <header class="site-header">
        <a class="home-link" href="/" aria-label="Laravel Truss home">
          <Logo size={22} />
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener' : undefined}
                  aria-current={active && item.key === active ? 'page' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
          <a class="cta" href="/getting-started/installation/">Get started</a>
          <a class="gh-link" href="https://github.com/albertoarena/laravel-truss" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.55 7.55 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          </a>
          <button class="theme-toggle" type="button" data-theme-cycle data-mode="auto" aria-label="Theme: system" title="Theme: system (click to change)">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <g class="ti ti-light" stroke-linecap="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </g>
              <path class="ti ti-dark" d="M20 14.5A8 8 0 1 1 9.5 4a6.2 6.2 0 0 0 10.5 10.5z" />
              <g class="ti ti-system" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4.5" width="18" height="12" rx="1.5" />
                <path d="M8.5 20.5h7M12 16.5v4" />
              </g>
            </svg>
          </button>
        </nav>
      </header>

      {/* tabindex="-1" so the skip link actually moves focus here: without it
          the browser scrolls but focus stays on the link, and the next Tab
          returns to the header the user just skipped. */}
      <main class="site-main" id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <a class="home-link" href="/" aria-label="Laravel Truss home">
          <Logo size={20} framework />
        </a>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/getting-started/installation/">Get started</a>
          <a href="/roadmap/">Roadmap</a>
          <a href="/credits/">Credits</a>
          <a href="/privacy/">Privacy</a>
          <a href="https://github.com/albertoarena/laravel-truss" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.youtube.com/playlist?list=PLdadt28gT2Qc" target="_blank" rel="noopener">Videos</a>
          <a href="https://ko-fi.com/albertoarena" target="_blank" rel="noopener">Support</a>
        </nav>
        <p class="colophon">MIT licensed. Structure only, never row data.</p>
      </footer>
    </div>

    {/* Also mounted in the Starlight Footer override: the docs pages do not use
        this layout, so a banner added only here would cover half the site. */}
    <CookieConsent />

    <script is:inline>
      (function () {
        var KEY = 'starlight-theme'
        var order = ['light', 'dark', 'auto']
        var btn = document.querySelector('[data-theme-cycle]')
        if (!btn) return
        function pref() {
          try { var v = localStorage.getItem(KEY); if (v === 'light' || v === 'dark') return v } catch (e) {}
          return 'auto'
        }
        function resolved(p) {
          return p === 'auto' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : p
        }
        function reflect(p) {
          document.documentElement.dataset.theme = resolved(p)
          btn.dataset.mode = p
          btn.setAttribute('aria-label', 'Theme: ' + p)
          btn.title = 'Theme: ' + p + ' (click to change)'
        }
        btn.addEventListener('click', function () {
          var next = order[(order.indexOf(pref()) + 1) % order.length]
          try { localStorage.setItem(KEY, next === 'auto' ? '' : next) } catch (e) {}
          reflect(next)
        })
        // In auto, follow the OS while the page is open (tokens are data-theme keyed).
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (pref() === 'auto') reflect('auto')
        })
        reflect(pref())
      })()
    </script>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: var(--truss-bg);
    color: var(--truss-fg);
    font-family: var(--truss-font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    background-image:
      linear-gradient(var(--truss-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--truss-grid) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }

  /* The framed blueprint column: contained, with thin vertical rules. */
  .frame {
    max-width: var(--truss-content-width);
    margin: 0 auto;
    min-height: 100vh;
    background: var(--truss-panel);
    border-left: 1px solid var(--truss-line);
    border-right: 1px solid var(--truss-line);
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 640px) {
    .frame { border-left: 0; border-right: 0; }
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px var(--truss-gutter);
    border-bottom: 1px solid var(--truss-line);
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--truss-panel) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
  }
  .home-link { text-decoration: none; display: inline-flex; }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    font-family: var(--truss-font-mono);
    font-size: 13px;
    color: var(--truss-muted);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] { color: var(--truss-fg); }
  .site-nav a[aria-current='page'] { font-weight: 600; }

  .cta {
    font-family: var(--truss-font-mono) !important;
    font-size: 13px;
    font-weight: 600;
    color: var(--truss-on-ink) !important;
    background: var(--truss-ink);
    padding: 8px 14px;
    border-radius: var(--truss-radius);
  }
  .cta:hover { opacity: 0.92; }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--truss-line);
    border-radius: var(--truss-radius);
    background: var(--truss-field);
    color: var(--truss-muted);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--truss-fg); }
  /* One cycling icon, three states: the icon matching the current mode shows. */
  .theme-toggle .ti { display: none; }
  .theme-toggle[data-mode='light'] .ti-light { display: inline; }
  .theme-toggle[data-mode='dark'] .ti-dark { display: inline; }
  .theme-toggle[data-mode='auto'] .ti-system { display: inline; }

  .gh-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: var(--truss-muted);
  }
  .gh-link:hover { color: var(--truss-fg); }

  /* On narrow screens, drop the text links and keep the essentials. */
  @media (max-width: 720px) {
    .site-nav ul { display: none; }
  }

  .site-main { flex: 1; }

  .site-footer {
    border-top: 1px solid var(--truss-line);
    padding: 30px var(--truss-gutter);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-nav a {
    font-family: var(--truss-font-mono);
    font-size: 13px;
    color: var(--truss-muted);
    text-decoration: none;
  }
  .footer-nav a:hover { color: var(--truss-fg); }
  .colophon {
    margin: 0;
    font-family: var(--truss-font-mono);
    font-size: 12px;
    color: var(--truss-muted);
  }

  :global(a:focus-visible),
  .theme-toggle:focus-visible {
    outline: 2px solid var(--truss-cyan);
    outline-offset: 2px;
    border-radius: 3px;
  }

  /* Visible to assistive technology only. Starlight ships its own .sr-only, but
     these hand-authored pages do not load it, so the class is defined here.
     Clipped rather than display:none or visibility:hidden, both of which remove
     the element from the accessibility tree and would silence a live region. */
  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Off-screen until focused, then a normal-looking control at the top left.
     Positioned rather than display:none or visibility:hidden, both of which
     take it out of the tab order and defeat the point. */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 10px 16px;
    font-family: var(--truss-font-mono);
    font-size: 13px;
    color: var(--truss-fg);
    background: var(--truss-field);
    border: 1px solid var(--truss-line);
    border-radius: 0 0 var(--truss-radius) 0;
    text-decoration: none;
  }
  .skip-link:focus {
    left: 0;
  }

  /* The skip target must not draw a ring of its own: focus lands on <main>
     programmatically, and outlining the whole page column looks like a bug. */
  .site-main:focus {
    outline: none;
  }

  @media (max-width: 640px) {
    .site-header, .site-footer { padding-left: 22px; padding-right: 22px; }
  }

  /* 1.4.10 Reflow. At the 320px the criterion tests, the header ran 8px wider
     than the viewport and the whole page scrolled sideways: the nav's text
     links are already hidden by then, but the wordmark, the CTA, the GitHub
     link and the theme toggle plus their gaps still did not fit. Tightening the
     gutters and the gaps buys about 32px, which clears it without dropping any
     control. */
  @media (max-width: 420px) {
    .site-header, .site-footer { padding-left: 16px; padding-right: 16px; }
    .site-header { gap: 12px; }
    .site-nav { gap: 14px; }
  }
</style>
