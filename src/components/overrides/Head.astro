---
/**
 * Adds schema.org structured data and the social card to every Starlight page.
 *
 * The docs pages do not render through SiteLayout, so the graph emitted there
 * reaches only the landing and the roadmap. This is the other half. Both build
 * their nodes from src/scripts/structured-data.js, so the two paths cannot
 * describe the site differently.
 *
 * Wraps Starlight's own Head rather than replacing it: everything it emits
 * (title, canonical, OpenGraph, the configured head array) still applies.
 */
import Default from '@astrojs/starlight/components/Head.astro'

import { coverUrlOf } from '../../scripts/social-cover.js'
import {
  graph,
  personNode,
  websiteNode,
  softwareApplicationNode,
  techArticleNode,
  breadcrumbNode,
  faqNode,
} from '../../scripts/structured-data.js'
import { FAQ } from '../../data/faq.ts'

const { entry, lastUpdated } = Astro.locals.starlightRoute

const site = (Astro.site ?? new URL('https://trussphp.com')).origin
const pathname = Astro.url.pathname
const url = new URL(pathname, `${site}/`).href

// The card. Emitted here rather than from the head array in astro.config so the
// choice can depend on the page: /filament/ documents a separate package and
// shares its own art, where a head array would apply one card to every
// Starlight page alike.
//
// Two other paths emit the same tags and share no code with this one: SiteLayout
// for the landing, the roadmap and in the wild, and scripts/static-page-meta.mjs
// injecting into the pages copied verbatim out of public/. All three declare the
// same nominal 1200x630, which every card is cut to the shape of. The file behind
// it may be that size or a whole multiple of it, and a test holds both.
const cover = coverUrlOf(entry.id, {
  site: `${site}/`,
  base: import.meta.env.BASE_URL.replace(/\/$/, ''),
})

const nodes = [
  personNode(site),
  websiteNode(site),
  // Every docs page is about the package, and each article says so via
  // about: { @id }. The node has to be present for that reference to resolve,
  // and carrying it means each page describes the thing it documents in full
  // rather than pointing at something defined only on the landing page.
  softwareApplicationNode(site),
  techArticleNode(site, {
    title: entry.data.title,
    description: entry.data.description,
    url,
    // starlightRoute.lastUpdated is the resolved date, from git history or a
    // frontmatter override. entry.data.lastUpdated is only ever the override,
    // so reading it left dateModified absent on every page.
    dateModified: lastUpdated,
  }),
]

const breadcrumb = breadcrumbNode(site, pathname, entry.data.title)
if (breadcrumb) nodes.push(breadcrumb)

// Only the page that actually shows the questions may claim to be an FAQPage.
const faq = entry.data.faq ? faqNode(site, FAQ) : null
if (faq) nodes.push(faq)
---

<Default><slot /></Default>
<meta property="og:image" content={cover} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={cover} />
<script type="application/ld+json" set:html={JSON.stringify(graph(nodes))} is:inline />
