---
/**
 * Starlight SiteTitle override: use the Truss lockup (mark + "truss") instead of
 * the default logo + text title, so the docs header matches the custom pages.
 */
import Logo from '../Logo.astro'
const { siteTitleHref } = Astro.locals.starlightRoute
---
<a href={siteTitleHref} class="site-title sl-flex" aria-label="Laravel Truss home">
  <Logo size={20} />
</a>

<style>
  .site-title {
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }
</style>
