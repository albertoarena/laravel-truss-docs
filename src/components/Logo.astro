---
/**
 * Mark + wordmark lockup. Defaults to the compact header lockup: mark + plain
 * lowercase "truss", no chord (the mark already carries the truss idea beside
 * the word). Pass framework for the muted "laravel truss" variant.
 */
import Mark from './Mark.astro'
import Wordmark from './Wordmark.astro'

interface Props {
  size?: number
  framework?: boolean
  chord?: boolean
  class?: string
}
const { size = 26, framework = false, chord = false, class: className } = Astro.props
const markSize = Math.round(size * 1.3)
---
<span class:list={['logo', className]}>
  <Mark size={markSize} />
  <Wordmark size={size} framework={framework} chord={chord} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    color: var(--truss-ink);
    text-decoration: none;
  }
</style>
